+    /// vaccel patch: write all slices with writev, retrying partial writes
+    pub fn write_all_vectored(&self, bufs: &[&[u8]]) -> Result<()> {
+        let mut iov: Vec<libc::iovec> = bufs
+            .iter()
+            .filter(|b| !b.is_empty())
+            .map(|b| libc::iovec { iov_base: b.as_ptr() as *mut libc::c_void, iov_len: b.len() })
+            .collect();
+        let mut first = 0;
+        while first < iov.len() {
+            let cnt = std::cmp::min(iov.len() - first, 1024) as libc::c_int;
+            let n = unsafe { libc::writev(self.fd, iov[first..].as_ptr(), cnt) };
+            if n < 0 {
+                let e = nix::errno::Errno::last();
+                if retryable(e) {
+                    continue;
+                }
+                return Err(crate::Error::Nix(e));
+            }
+            let mut n = n as usize;
+            while first < iov.len() && n >= iov[first].iov_len {
+                n -= iov[first].iov_len;
+                first += 1;
+            }
+            if n > 0 {
+                iov[first].iov_base = unsafe { (iov[first].iov_base as *mut u8).add(n) } as *mut libc::c_void;
+                iov[first].iov_len -= n;
+            }
+        }
+        Ok(())
+    }
