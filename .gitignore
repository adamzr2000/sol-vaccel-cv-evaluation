# ignore everything under app/models
app/models/**/*
# keep readmes and per-folder .gitignore files
!app/models/**/README.md
!app/models/**/.gitignore

sol-installers/

__pycache__/
.sol/

.env
.venv/
app/static/videos/uploads/

dds
.db3

*.pt2

# ignore generated artifacts inside _sol model dirs, keep vaccel subdir
src/models/*_sol/**/*.so
src/models/*_sol/**/*.c
src/models/*_sol/**/*.h
src/models/*_sol/**/*.py
!src/models/*_sol/**/vaccel/
!src/models/*_sol/**/vaccel/**

# ignore media artifacts under src/data
src/data/**/*.jpg
src/data/**/*.mp4

# ignore large COCO train annotation jsons
src/data/**/annotations/*_train2017.json
