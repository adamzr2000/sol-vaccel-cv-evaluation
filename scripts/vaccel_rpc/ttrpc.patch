+/// vaccel patch: send an already encoded ttrpc `Response` body
+pub fn response_raw_to_channel(
+    stream_id: u32,
+    buf: Vec<u8>,
+    tx: std::sync::mpsc::Sender<(MessageHeader, Vec<u8>)>,
+) -> Result<()> {
+    if check_oversize(buf.len(), true).is_err() {
+        return Err(Error::Others(format!("response of {} bytes is too large", buf.len())));
+    }
+    let mh = MessageHeader {
+        length: buf.len() as u32,
+        stream_id,
+        type_: MESSAGE_TYPE_RESPONSE,
+        flags: 0,
+    };
+    tx.send((mh, buf)).map_err(err_to_others_err!(e, ""))?;
+    Ok(())
+}
